# Luno public API base URL. Credentials are optional for public market reads.
LUNO_API_URL=https://api.luno.com
LUNO_API_KEY_ID=
LUNO_API_KEY_SECRET=

# Optional local control/private-read protection. Generate at least 32 random
# characters. When set, the UI must send it as X-AutoLuno-Token.
AUTOLUNO_OPERATOR_TOKEN=
AUTOLUNO_AI_ENABLED=false
AUTOLUNO_AI_PROVIDER=ollama
AUTOLUNO_OLLAMA_MODEL=qwen2.5-coder:0.5b

# MongoDB storage used by history, settings, and paper-decision logs.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_NAME=autoluno
AUTOLUNO_MONGO_TIMEOUT_SECONDS=3

# Local runtime boundaries.
AUTOLUNO_PYTHON_HOST=127.0.0.1
AUTOLUNO_PYTHON_PORT=8001
AUTOLUNO_ALLOW_REMOTE_BIND=false
AUTOLUNO_WAITRESS_THREADS=8
AUTOLUNO_FRONTEND_PORT=3001
AUTOLUNO_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
AUTOLUNO_TIMEZONE=Africa/Johannesburg

# Optional path to private legacy SQLite/JSON snapshots for migration.
AUTOLUNO_LEGACY_SNAPSHOT_DIR=private-data/legacy-snapshots

# Paper account defaults. Size values are counter-currency notionals.
AUTOLUNO_PAPER_STARTING_CASH=10000
AUTOLUNO_PAPER_FEE_RATE=0.001

# Optional host-local research services.
SEARXNG_URL=http://127.0.0.1:8080/
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_URL=http://127.0.0.1:11434

# Optional research services are opt-in; the core dashboard does not require them.
SEARXNG_AUTO_SETUP=false
SEARXNG_AUTO_START=false
QDRANT_AUTO_SETUP=false
QDRANT_AUTO_START=false
OLLAMA_AUTO_SETUP=false
OLLAMA_AUTO_START=false
